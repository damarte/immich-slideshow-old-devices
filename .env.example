IMMICH_URL=http://external-immich:2283
IMMICH_API_KEY=APIKEY
ALBUM_ID=ALBUMID,ALBUMID2
CAROUSEL_DURATION=5
CSS_BACKGROUND_COLOR=#000000
RANDOM_ORDER=false # true/false
STATUS_BAR_STYLE=black-translucent # default, black, black-translucent
IMAGES_ORIENTATION=all # landscape, portrait, all
CROP_TO_SCREEN=true # true/false
IMAGE_QUALITY=preview # preview (recommended), fullsize
TRANSITION_SECONDS=1 # crossfade length in seconds
SHOW_INFO=false # true/false, show photo date and albums
ACTIVE_HOURS= # e.g. 07:00-23:00 (black screen outside), empty = always on
